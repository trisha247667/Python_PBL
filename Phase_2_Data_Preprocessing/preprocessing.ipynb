# Phase 2 Content
phase_2_readme = """# Phase 2: Data Preprocessing

## Objective
To clean raw email text and transform it into a numerical format suitable for Machine Learning models.

## Steps Involved
1. **Lowercase Conversion**: Standardizing text to remove case sensitivity.
2. **Punctuation Removal**: Stripping out special characters.
3. **Tokenization**: Breaking down sentences into individual words.
4. **TF-IDF Vectorization**: Converting text into a numerical matrix.
"""

phase_2_code = """import pandas as pd
import string
from sklearn.feature_extraction.text import TfidfVectorizer

# --- STEP 1: LOAD THE DATA ---
df = pd.read_csv('spam_dataset.csv')

# --- STEP 2: TEXT CLEANING ---
def clean_text(text):
    text = text.lower()
    text = "".join([char for char in text if char not in string.punctuation])
    return text

print("Cleaning text data...")
df['cleaned_message'] = df['message'].apply(clean_text)

# --- STEP 3: TF-IDF VECTORIZATION ---
print("Converting text to numerical features (TF-IDF)...")
tfidf = TfidfVectorizer(stop_words='english', max_features=1000)
X = tfidf.fit_transform(df['cleaned_message'])

# Convert labels: 'spam' -> 1, 'ham' -> 0
df['label_num'] = df['label'].map({'spam': 1, 'ham': 0})

print("\\n--- Phase 2 Complete ---")
print(f"Feature Matrix Shape: {X.shape}")
"""

with open("README_Phase2.md", "w") as f:
    f.write(phase_2_readme)

with open("preprocessing.py", "w") as f:
    f.write(phase_2_code)
